# Lakebase SCM extension configuration. Copy to .env and fill in the two values below.
# The extension fills in the connection block when you create or switch branches.

DATABRICKS_HOST=https://<HOSTNAME>
LAKEBASE_PROJECT_ID=<LAKEBASE_PROJECT_ID>

# Connection metadata (written by the extension on branch switch; no token is stored)
# LAKEBASE_BRANCH_ID=
# LAKEBASE_HOST=
# LAKEBASE_ENDPOINT=primary
# DB_USERNAME=
